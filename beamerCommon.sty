\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerCommon}[2026/10/03 Shared Template colours, fonts, and helpers]

\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{booktabs}
\RequirePackage{listings}
\IfFileExists{svg.sty}{%
  \RequirePackage[notransparent]{svg}
  \svgsetup{inkscapelatex=false,inkscapeopt=--export-text-to-path}%
}{}

\definecolor{burgundy}{HTML}{7A003C}
\definecolor{orange}{HTML}{DA3A16}
\definecolor{turquoise}{HTML}{057D78}
\definecolor{darkblue}{HTML}{004085}
\colorlet{templatePrimary}{burgundy}
\colorlet{templateSecondary}{turquoise}
\definecolor{templateInk}{HTML}{222222}
\definecolor{templateMuted}{HTML}{666666}
\definecolor{templatePaper}{HTML}{FFFFFF}

\setbeamercolor{normal text}{fg=templateInk,bg=templatePaper}
\setbeamercolor{background canvas}{bg=templatePaper}
\setbeamercolor{structure}{fg=templatePrimary}
\setbeamercolor{alerted text}{fg=templatePrimary}
\setbeamercolor{title}{fg=templatePrimary}
\setbeamercolor{subtitle}{fg=templateInk}
\setbeamercolor{frametitle}{fg=templatePrimary,bg=templatePaper}
\setbeamercolor{framesubtitle}{fg=templateMuted}
\setbeamercolor{section in toc}{fg=templateInk}
\setbeamercolor{block title}{fg=templatePaper,bg=templatePrimary}
\setbeamercolor{block body}{fg=templateInk,bg=templatePrimary!6!templatePaper}
\setbeamercolor{block title example}{fg=templatePaper,bg=templateSecondary}
\setbeamercolor{block body example}{fg=templateInk,bg=templateSecondary!6!templatePaper}
\setbeamercolor{block title alerted}{fg=white,bg=orange}
\setbeamercolor{block body alerted}{fg=templateInk,bg=orange!6!templatePaper}
\setbeamercolor{takeaway}{fg=templatePrimary,bg=templatePrimary!6!templatePaper}
\setbeamercolor{placeholder}{fg=templateMuted,bg=templateInk!5!templatePaper}
\setbeamercolor{page number in head/foot}{fg=templateMuted,bg=templatePaper}

\usefonttheme{professionalfonts}
\setbeamerfont{title}{size=\LARGE,series=\bfseries}
\setbeamerfont{subtitle}{size=\large,series=\mdseries}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\small}
\setbeamerfont{frametitle}{size=\Large,series=\mdseries}
\setbeamerfont{framesubtitle}{size=\small}
\setbeamerfont{section title}{size=\LARGE,series=\bfseries}
\setbeamerfont{block title}{size=\normalsize,series=\bfseries}
\setbeamerfont{block body}{size=\normalsize}
\setbeamerfont{caption}{size=\footnotesize}
\setbeamerfont{footnote}{size=\scriptsize}
\setbeamerfont{takeaway}{size=\normalsize}
\setbeamerfont{source}{size=\scriptsize}

\setbeamerfont{metric}{size*={24}{27},series=\bfseries}
\newlength{\templateBoxPadding}
\newlength{\templateFigureHeight}
\setlength{\templateBoxPadding}{2mm}
\setlength{\templateFigureHeight}{3.2cm}

\lstdefinestyle{template}{
  basicstyle=\ttfamily\footnotesize\color{templateInk},
  keywordstyle=\color{darkblue}\bfseries,
  stringstyle=\color{turquoise},
  commentstyle=\color{templateMuted}\itshape,
  backgroundcolor=\color{templateInk!4!templatePaper},
  frame=single,
  rulecolor=\color{templateInk!15!templatePaper},
  framerule=0.3pt,
  framesep=2mm,
  numbers=left,
  numberstyle=\tiny\color{templateMuted},
  numbersep=2mm,
  stepnumber=1,
  firstnumber=1,
  xleftmargin=2mm,
  xrightmargin=2mm,
  showstringspaces=false,
  columns=fullflexible,
  keepspaces=true,
  breaklines=true,
  tabsize=2
}
\lstset{style=template}

\setbeamertemplate{itemize items}[circle]
\setbeamertemplate{enumerate items}[default]
\setbeamertemplate{section in toc}[sections numbered]
\setbeamertemplate{blocks}[default]

\newcommand{\templateIncludeLogo}[3]{%
  \IfFileExists{#3}{%
    \begingroup
    \filename@parse{#3}%
    \def\templateSVGExtension{svg}%
    \ifx\filename@ext\templateSVGExtension
      \@ifpackageloaded{svg}{%
        \includesvg[width=#1,height=#2,keepaspectratio]{#3}%
      }{%
        \PackageError{beamerCommon}{SVG logos require the svg package}{%
          Install the LaTeX svg package and Inkscape, then compile with -shell-escape.}%
      }%
    \else
      \includegraphics[width=#1,height=#2,keepaspectratio]{#3}%
    \fi
    \endgroup
  }{}%
}

\newlength{\templateLogoGap}
\newcommand{\logobar}[4][10mm]{%
  \begingroup
  \setlength{\templateLogoGap}{0.0253\linewidth}%
  \begin{minipage}[c]{0.25\linewidth}
    \raggedright
    \templateIncludeLogo{\dimexpr\linewidth-\templateLogoGap\relax}{#1}{#2}%
  \end{minipage}%
  \begin{minipage}[c]{0.25\linewidth}
    \raggedright
    \templateIncludeLogo{0.96\linewidth}{#1}{#3}%
  \end{minipage}%
  \begin{minipage}[c]{0.50\linewidth}
    \raggedleft
    \templateIncludeLogo{0.40\linewidth}{#1}{#4}%
  \end{minipage}%
  \endgroup
}

\newenvironment<>{colorblock}[2][burgundy]{%
  \begingroup
  \setbeamercolor{block title}{fg=white,bg=#1}%
  \setbeamercolor{block body}{fg=templateInk,bg=#1!6!templatePaper}%
  \begin{block}#3{#2}%
}{%
  \end{block}%
  \endgroup
}

\newcommand{\takeaway}[1]{%
  \par\medskip
  \begin{beamercolorbox}[wd=\linewidth,sep=\templateBoxPadding]{takeaway}
    \usebeamerfont{takeaway}#1\par
  \end{beamercolorbox}%
}

\newcommand{\source}[1]{%
  \par\smallskip{\raggedright\usebeamerfont{source}\color{templateMuted}#1\par}%
}

\newcommand{\metric}[2]{%
  \par{\usebeamerfont{metric}\color{templatePrimary}#1\par}%
  \smallskip{\small #2\par}%
}

\newcommand{\figureplaceholder}[2][\templateFigureHeight]{%
  \begin{beamercolorbox}[wd=\linewidth,center,sep=0pt]{placeholder}
    \begin{minipage}[c][#1][c]{0.92\linewidth}
      \centering\small #2\par
    \end{minipage}%
  \end{beamercolorbox}%
}
