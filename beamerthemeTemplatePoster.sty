\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeTemplatePoster}[2026/10/03 Template portrait poster layout]
\RequirePackage{beamerCommon}

\newlength{\templatePosterMargin}
\newlength{\templatePosterGap}
\newlength{\templatePosterColumnWidth}
\newlength{\templatePosterBlockGap}
\newlength{\templatePosterBlockPadding}
\setlength{\templatePosterMargin}{0.03\paperwidth}
\setlength{\templatePosterGap}{0.025\paperwidth}
\setlength{\templatePosterColumnWidth}{%
  \dimexpr(\paperwidth-2\templatePosterMargin-\templatePosterGap)/2\relax}
\setlength{\templatePosterBlockGap}{0.012\paperheight}
\setlength{\templatePosterBlockPadding}{0.007\paperwidth}
\setbeamersize{text margin left=\templatePosterMargin,
  text margin right=\templatePosterMargin}

\setbeamerfont{title}{size=\Huge}
\setbeamerfont{author}{size=\large}
\setbeamerfont{institute}{size=\normalsize}
\setbeamerfont{date}{size=\small}
\setbeamerfont{metric}{size=\LARGE}
\setbeamerfont{caption}{size=\small}
\setbeamerfont{source}{size=\footnotesize}
\AtBeginDocument{%
  \setlength{\tabcolsep}{0.65em}%
  \renewcommand{\arraystretch}{1.15}%
}
\setlength{\templateBoxPadding}{0.006\paperwidth}
\setlength{\templateFigureHeight}{0.18\paperheight}
\lstset{framesep=0.5em,numbersep=0.5em,xleftmargin=0.5em,
  xrightmargin=0.5em,framerule=0.025em}

\newcommand{\templatePosterBlockBegin}[2]{%
  \par\vskip\medskipamount
  \begin{beamercolorbox}[wd=\linewidth,sep=\templatePosterBlockPadding]{#1}
    \usebeamerfont{block title}\strut\insertblocktitle\strut\par
  \end{beamercolorbox}%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\linewidth,sep=0pt]{#2}
    \hspace*{\templatePosterBlockPadding}%
    \begin{minipage}{\dimexpr\linewidth-2\templatePosterBlockPadding\relax}
      \usebeamerfont{block body}\raggedright
      \vspace*{\templatePosterBlockPadding}
}
\newcommand{\templatePosterBlockEnd}{%
      \par\vspace*{\templatePosterBlockPadding}
    \end{minipage}%
    \par
  \end{beamercolorbox}%
  \vskip\smallskipamount
}
\setbeamertemplate{block begin}{\templatePosterBlockBegin{block title}{block body}}
\setbeamertemplate{block end}{\templatePosterBlockEnd}
\setbeamertemplate{block example begin}{\templatePosterBlockBegin{block title example}{block body example}}
\setbeamertemplate{block example end}{\templatePosterBlockEnd}
\setbeamertemplate{block alerted begin}{\templatePosterBlockBegin{block title alerted}{block body alerted}}
\setbeamertemplate{block alerted end}{\templatePosterBlockEnd}

\RequirePackage{etoolbox}
\let\templatePosterColorBlock\colorblock
\let\endtemplatePosterColorBlock\endcolorblock
\newsavebox{\templatePosterPendingBox}
\newsavebox{\templatePosterCurrentBox}
\newif\iftemplatePosterPending

\newcommand{\templatePosterFlushBlocks}{%
  \iftemplatePosterPending
    \par\noindent\usebox{\templatePosterPendingBox}\par
    \vspace{\templatePosterBlockGap}%
    \global\templatePosterPendingfalse
  \fi
}
\AtBeginEnvironment{beamer@frameslide}{\global\templatePosterPendingfalse}
\AtEndEnvironment{beamer@frameslide}{\templatePosterFlushBlocks}

\renewenvironment{colorblock}[2][burgundy]{%
  \begin{lrbox}{\templatePosterCurrentBox}%
    \begin{minipage}[t]{\templatePosterColumnWidth}
      \vspace{0pt}%
      \begin{templatePosterColorBlock}[#1]{#2}%
}{%
      \end{templatePosterColorBlock}%
    \end{minipage}%
  \end{lrbox}%
  \iftemplatePosterPending
    \par\noindent\usebox{\templatePosterPendingBox}%
    \hspace*{\templatePosterGap}\usebox{\templatePosterCurrentBox}\par
    \vspace{\templatePosterBlockGap}%
    \global\templatePosterPendingfalse
  \else
    \global\setbox\templatePosterPendingBox=\copy\templatePosterCurrentBox
    \global\templatePosterPendingtrue
  \fi
  \ignorespacesafterend
}
\newenvironment{colorblock*}[2][burgundy]{%
  \templatePosterFlushBlocks
  \par\noindent\begin{minipage}[t]{\textwidth}
    \vspace{0pt}%
    \begin{templatePosterColorBlock}[#1]{#2}%
}{%
    \end{templatePosterColorBlock}%
  \end{minipage}\par
  \vspace{\templatePosterBlockGap}%
  \ignorespacesafterend
}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{sidebar right}{}
\setbeamertemplate{footline}{}
\setbeamertemplate{frametitle}{}
\setbeamertemplate{headline}{%
  \begin{beamercolorbox}[wd=\paperwidth,sep=0pt]{normal text}
    \hspace*{\templatePosterMargin}%
    \begin{minipage}{\dimexpr\paperwidth-2\templatePosterMargin\relax}
      \vspace*{\templatePosterMargin}
      \raggedright
      \ifx\inserttitlegraphic\@empty\else
        {\normalsize\inserttitlegraphic\par}
        \vspace{0.012\paperheight}
      \fi
      \centering
      {\usebeamerfont{title}\color{templatePrimary}\inserttitle\par}
      \vspace{0.007\paperheight}
      {\usebeamerfont{author}\insertauthor\par}
      \vspace{0.003\paperheight}
      {\usebeamerfont{institute}\insertinstitute\par}
      \vspace{0.003\paperheight}
      {\usebeamerfont{date}\color{templateMuted}\insertdate\par}
      \vspace{0.012\paperheight}
      {\color{templatePrimary!30!templatePaper}\hrule height 0.0006\paperwidth}
      \vspace{0.009\paperheight}
    \end{minipage}%
    \par
  \end{beamercolorbox}%
}
